<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#12FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</selector>
